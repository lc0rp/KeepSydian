{
	"name": "keepsidian",
	"version": "2.1.0-beta.12",
	"description": "Sync Google Keep notes to Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run lint:ts && tsc --project tsconfig.json --noEmit --skipLibCheck && node esbuild.config.mjs production && npm run verify:bundles",
		"prebuild": "npm run barrels",
		"barrels": "barrelsby --config barrelsby.json",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
		"format": "prettier \"apps/**/*.{ts,tsx,md}\" --write",
		"lint": "node scripts/lint-wrapper.mjs",
		"lint:ts": "ESLINT_USE_FLAT_CONFIG=true npx eslint -c eslint.config.mjs src",
		"lint:ts:fix": "ESLINT_USE_FLAT_CONFIG=true npx eslint -c eslint.config.mjs src --fix",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
		"lint:fix": "node scripts/lint-wrapper.mjs --fix",
		"verify:bundles": "node scripts/verify-bundles.mjs",
		"preversion": "npm run lint"
	},
	"keywords": [
		"obsidian",
		"google keep",
		"sync",
		"plugin"
	],
	"author": "lc0rp",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@eslint/json": "^0.14.0",
		"@jest/globals": "29.7.0",
		"@testing-library/jest-dom": "^6.6.2",
		"@types/electron": "^1.4.38",
		"@types/jest": "^29.5.14",
		"@types/mocha": "^10.0.10",
		"@types/node": "^16.18.126",
		"@types/semver": "7.7.1",
		"@typescript-eslint/eslint-plugin": "8.39.0",
		"@typescript-eslint/parser": "8.39.0",
		"@wdio/appium-service": "^9.21.0",
		"@wdio/cli": "^9.21.1",
		"@wdio/globals": "^9.17.0",
		"@wdio/local-runner": "^9.21.0",
		"@wdio/mocha-framework": "^9.21.0",
		"@wdio/spec-reporter": "^9.20.0",
		"appium": "3.1.2",
		"appium-uiautomator2-driver": "7.5.2",
		"barrelsby": "^2.8.1",
		"electron": "^32.1.2",
		"esbuild": "^0.17.3",
		"eslint": "^9.39.1",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"expect-webdriverio": "^5.5.0",
		"globals": "^14.0.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"markdownlint-cli2": "^0.20.0",
		"mocha": "^11.7.5",
		"obsidian": "^1.6.6",
		"prettier": "^3.7.4",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"tslib": "2.4.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "8.39.0",
		"wdio-obsidian-reporter": "^2.1.6",
		"wdio-obsidian-service": "^2.1.6"
	},
	"dependencies": {
		"semver": "7.8.5",
		"zod": "^4.1.8"
	},
	"overrides": {
		"@babel/core": "7.29.7",
		"brace-expansion@1": "1.1.16",
		"brace-expansion@2": "2.1.2",
		"js-yaml@3": "3.15.0",
		"js-yaml@4": "4.3.0",
		"minimatch@10": "10.1.1",
		"picomatch@2": "2.3.2",
		"picomatch@4": "4.0.5"
	}
}
